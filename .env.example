# Public application
NEXT_PUBLIC_SITE_URL=https://makeartalanya.com
NEXT_PUBLIC_DEFAULT_LOCALE=tr
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase
SUPABASE_SERVICE_ROLE_KEY=

# Signed legacy admin login
ADMIN_DASHBOARD_USER=
ADMIN_DASHBOARD_PASSWORD=
ADMIN_SESSION_SECRET=

# AI concierge. Prefer a Türkiye-hosted OpenAI-compatible endpoint.
AI_PROVIDER=openrouter
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Keep false for an overseas provider until the Art. 9 KVKK transfer mechanism
# (for example the applicable standard contract + notification) is completed.
CONCIERGE_ALLOW_EXTERNAL_PROVIDER=false

# Public company registry fields required before a commercial launch.
NEXT_PUBLIC_COMPANY_MERSIS_NO=
NEXT_PUBLIC_COMPANY_TRADE_REGISTRY_NO=
NEXT_PUBLIC_COMPANY_DIRECTOR=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_LINK_CODE=
TELEGRAM_WEBHOOK_SECRET=

# Optional email notifications
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=info@makeartalanya.com
SMTP_PASS=
FROM_EMAIL="Make Art Studio <info@makeartalanya.com>"
ADMIN_NOTIFICATION_EMAIL=info@makeartalanya.com
