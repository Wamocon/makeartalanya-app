# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# playwright
.playwright-mcp/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
e2e/tests/*.spec.ts-snapshots/

# local verification artifacts
/scripts/screenshots*/
/scripts/*.log
/dev.log
/start.log
.gstack/
.gallery-cache/

# Original studio photos (HEIC/full-res). Source for scripts/build-gallery.mjs;
# never deployed. Backed up by OneDrive at this path.
source-photos/
